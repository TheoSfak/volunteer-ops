# VolunteerOps - Root Security Rules

# Block access to sensitive file types
<FilesMatch "\.(sql|log|md|sh|bak|env|ini)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Block direct access to config.local.php
<Files "config.local.php">
    Order Deny,Allow
    Deny from all
</Files>

# Private uploads must be served only through authenticated PHP endpoints:
# volunteer-doc-download.php, subscription-receipt.php, mission-photo-view.php,
# mission-voice-play.php. Each of those reads the file off disk with PHP, so
# denying Apache here costs them nothing - it only removes the URL that skipped
# their permission checks entirely.
#
# subscription-receipts was the one that mattered most and was missing: unlike
# the others the stored name is not random at all, it is the owner's
# transliterated surname (see subscriptions.php), so the files were not merely
# reachable, they were enumerable by anyone who knew a volunteer's name.
#
# mission-photos and mission-voice also write their own deny-all .htaccess from
# PHP (ensurePrivateUploadDir), which this does not replace: uploads/ is
# gitignored so that file cannot ship, and it is what protects a host with no
# mod_rewrite, where everything in this block is a no-op.
#
# Do NOT add logos, avatars, backgrounds, bug_reports or missing-persons - the
# app fetches those as direct <img src> and denying them breaks real pages.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/(volunteer-docs|training/materials|subscription-receipts|mission-photos|mission-voice)/ - [F,L]

    # Private runtime files, and any log that ever lands under uploads/. The
    # <FilesMatch> at the top of this file already denies *.log, but the live
    # hosts run LiteSpeed, which ignores it: uploads/mobile-debug.log (raw GPS
    # fixes with user ids) was downloadable there without logging in until
    # v3.336.1. storage/ also has its own deny-all .htaccess.
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^uploads/.*\.log$ - [F,L]

    # Apache strips the Authorization header from $_SERVER by default (it's
    # reserved for Apache's own Basic Auth) — mobile-ping-location.php and
    # mobile-token-issue.php's bearer-token auth (native Android app) need it
    # forwarded through explicitly, or every request 401s regardless of token.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Block access to install.php after deployment
# Uncomment the following lines after installation is complete:
# <Files "install.php">
#     Order Deny,Allow
#     Deny from all
# </Files>

# Block hidden files (.git, .github, etc.)
<FilesMatch "^\.">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable directory listing
Options -Indexes

# Prevent MIME sniffing
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
