+package com.capgo.capacitor_background_geolocation;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.SystemClock;
+import com.getcapacitor.Logger;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * VolunteerOps addition (not upstream, v3.322.0).
+ *
+ * Keeps every fix until the server has it. Before this, a fix whose POST
+ * failed was simply lost, so a volunteer walking through a gorge with no
+ * signal left no trace of the route they took through it — exactly the part
+ * of a search a coordinator most needs to see afterwards.
+ *
+ * Every fix is appended here and the buffer is emptied oldest first. A failed
+ * send keeps everything and stops; the next fix, or the 30-second alert poll,
+ * tries again. That order matters: the server skips any fix older than the
+ * newest one it already has, so sending a new fix ahead of a backlog would
+ * throw the backlog away.
+ *
+ * The reason v3.158.2 chose to DROP fixes instead no longer applies. Then, a
+ * backlog was replayed one POST per fix, holding the volunteer's current
+ * position back behind minutes of old ones, and every replayed fix was stamped
+ * with its arrival time. Now the backlog goes up in batches of 50 per request,
+ * so catching up takes seconds, and each fix carries its own age.
+ *
+ * Bounded twice: nothing older than 30 minutes (the server refuses those
+ * anyway, WAR_ROOM_MAX_FIX_AGE_SECONDS) and never more than 400 fixes (30
+ * minutes at the fastest cadence the settings allow). Persisted, so a service
+ * the system kills and restarts mid-outage does not lose it. Ages are measured
+ * on the monotonic clock; after a reboot that clock restarts and a kept fix's
+ * age can no longer be known, so it is dropped rather than guessed.
+ */
+final class VopsFixBuffer {
+
+    static final long MAX_AGE_MS = 30 * 60 * 1000L;
+    static final int MAX_ENTRIES = 400;
+    static final int BATCH = 50;
+
+    private static final String PREFS = "VopsFixBuffer";
+    private static final String KEY_ENTRIES = "entries";
+    private static final String KEY_SEQ = "seq";
+
+    private static final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private static final AtomicBoolean drainQueued = new AtomicBoolean(false);
+
+    private VopsFixBuffer() {}
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static JSONArray load(Context context) {
+        try {
+            return new JSONArray(prefs(context).getString(KEY_ENTRIES, "[]"));
+        } catch (Exception e) {
+            return new JSONArray();
+        }
+    }
+
+    private static void save(Context context, JSONArray entries) {
+        prefs(context).edit().putString(KEY_ENTRIES, entries.toString()).apply();
+    }
+
+    /** Drops what can no longer be delivered: too old, from before a reboot, or over the cap. */
+    private static JSONArray prune(JSONArray entries) {
+        long now = SystemClock.elapsedRealtime();
+        JSONArray kept = new JSONArray();
+        for (int i = 0; i < entries.length(); i++) {
+            JSONObject e = entries.optJSONObject(i);
+            // A damaged entry would sit at the head forever and block every
+            // fix behind it, so it goes here rather than at send time.
+            if (e == null || !e.has("i") || !e.has("e") || e.optJSONObject("p") == null) continue;
+            long age = now - e.optLong("e", Long.MIN_VALUE / 2);
+            if (age >= 0 && age <= MAX_AGE_MS) kept.put(e);
+        }
+        if (kept.length() <= MAX_ENTRIES) return kept;
+        JSONArray capped = new JSONArray();
+        for (int i = kept.length() - MAX_ENTRIES; i < kept.length(); i++) capped.put(kept.opt(i));
+        return capped;
+    }
+
+    /** Keeps one fix. $fixElapsedMs is on SystemClock.elapsedRealtime()'s clock. */
+    static synchronized void add(Context context, JSONObject payload, long fixElapsedMs) {
+        try {
+            SharedPreferences p = prefs(context);
+            long seq = p.getLong(KEY_SEQ, 0L) + 1;
+            p.edit().putLong(KEY_SEQ, seq).apply();
+            JSONObject entry = new JSONObject();
+            entry.put("i", seq);
+            entry.put("e", fixElapsedMs);
+            entry.put("p", payload);
+            JSONArray entries = load(context);
+            entries.put(entry);
+            save(context, prune(entries));
+        } catch (Exception e) {
+            Logger.error("Could not keep a fix", e);
+        }
+    }
+
+    static synchronized int size(Context context) {
+        return prune(load(context)).length();
+    }
+
+    /** Removes every kept fix with a sequence number up to and including $lastSeq. */
+    private static synchronized void removeThrough(Context context, long lastSeq) {
+        JSONArray entries = load(context);
+        JSONArray kept = new JSONArray();
+        for (int i = 0; i < entries.length(); i++) {
+            JSONObject e = entries.optJSONObject(i);
+            if (e != null && e.optLong("i") > lastSeq) kept.put(e);
+        }
+        save(context, prune(kept));
+    }
+
+    /** The oldest $max fixes, each stamped with its age as of now. */
+    private static synchronized JSONObject[] oldest(Context context, int max) {
+        JSONArray entries = prune(load(context));
+        save(context, entries);
+        int n = Math.min(max, entries.length());
+        JSONObject[] out = new JSONObject[n];
+        long now = SystemClock.elapsedRealtime();
+        for (int i = 0; i < n; i++) {
+            JSONObject e = entries.optJSONObject(i);
+            try {
+                // A copy: the kept entry must stay exactly as it was if this
+                // send fails, and its age is only true at this moment.
+                JSONObject payload = new JSONObject(e.getJSONObject("p").toString());
+                payload.put("fix_age_ms", Math.max(0L, now - e.getLong("e")));
+                JSONObject wrapped = new JSONObject();
+                wrapped.put("i", e.getLong("i"));
+                wrapped.put("p", payload);
+                out[i] = wrapped;
+            } catch (Exception ex) {
+                out[i] = null;
+            }
+        }
+        return out;
+    }
+
+    /**
+     * Empties the buffer in the background, oldest first. Coalesced: calls
+     * made while a drain is already waiting to run add nothing, so an outage
+     * does not pile up attempts behind each other — the failure the old
+     * unbounded post queue had.
+     */
+    static void drainAsync(Context context) {
+        if (!drainQueued.compareAndSet(false, true)) return;
+        final Context app = context.getApplicationContext();
+        executor.execute(() -> {
+            drainQueued.set(false);
+            drain(app);
+        });
+    }
+
+    private static void drain(Context context) {
+        while (true) {
+            JSONObject[] batch = oldest(context, BATCH);
+            if (batch.length == 0) return;
+            long lastSeq = -1;
+            try {
+                if (batch.length == 1) {
+                    // The everyday case, online: the same single-object body
+                    // every server version has always understood.
+                    if (batch[0] == null || LocationStore.postJson(context, batch[0].getJSONObject("p").toString()) == null) return;
+                    lastSeq = batch[0].getLong("i");
+                } else {
+                    JSONArray body = new JSONArray();
+                    for (JSONObject w : batch) {
+                        if (w != null) body.put(w.getJSONObject("p"));
+                    }
+                    String reply = LocationStore.postJson(context, body.toString());
+                    if (reply == null) return;
+                    if (reply.contains("\"batch\"")) {
+                        lastSeq = batch[batch.length - 1].getLong("i");
+                        DebugLog.log(context, "backlog_sent", body.length() + " fixes in one request");
+                    } else {
+                        // A server from before v3.322.0 does not know the list
+                        // form. One at a time, stopping at the first failure.
+                        for (JSONObject w : batch) {
+                            if (w == null) continue;
+                            if (LocationStore.postJson(context, w.getJSONObject("p").toString()) == null) break;
+                            lastSeq = w.getLong("i");
+                        }
+                    }
+                }
+            } catch (Exception e) {
+                // No signal, or the server refused the request itself: keep
+                // everything for the next attempt.
+                if (lastSeq >= 0) removeThrough(context, lastSeq);
+                DebugLog.log(context, "post_failed_kept", size(context) + " fixes kept: " + e.getMessage());
+                return;
+            }
+            if (lastSeq < 0) return;
+            removeThrough(context, lastSeq);
+        }
+    }
+}
