+package com.capgo.capacitor_background_geolocation;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.graphics.drawable.Icon;
+import android.media.AudioAttributes;
+import android.net.Uri;
+import android.media.RingtoneManager;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.PowerManager;
+
+import com.getcapacitor.Logger;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * VolunteerOps addition (not upstream).
+ *
+ * Raises a real Android notification when command staff send an order, a
+ * dispatch, or a global message, so it reaches a volunteer whose screen is
+ * off. Nothing else in the app can do this: the WebView implements neither
+ * the Push API nor the Notifications API, so Web Push - which works fine in
+ * the PWA - is simply unavailable here, and every in-page alert (banner, beep,
+ * SOS siren) is JavaScript the OS freezes the moment the screen goes dark.
+ *
+ * This piggybacks on the background-location foreground service, which is
+ * already running and already awake with the screen off, so it costs no new
+ * service, no new notification, and no Firebase dependency.
+ *
+ * v3.332.0: tapping a notification opens that order in the Action Room
+ * (EXTRA_OPEN_URL, read by the app's MainActivity), an order still waiting
+ * for «Ελήφθη» carries that button so it can be answered without unlocking
+ * the phone (AlertActionReceiver), and only orders ring loud — everything
+ * else goes to an ordinary channel.
+ */
+final class AlertPoller {
+
+    // Deliberately faster than the GPS cadence (AUTO_PING_CADENCE_MS, 3min):
+    // a location fix has to power up the GNSS radio and settle, whereas this
+    // is a sub-kilobyte HTTPS GET on a connection the service is holding open
+    // anyway, so it is far cheaper per call. 30s bounds the worst case a
+    // volunteer waits to hear about an order at half a minute instead of
+    // three, which is the difference between useful and not for a dispatch.
+    //
+    // Not lower, on purpose: below ~30s the wakeups start to dominate what the
+    // service costs, and this runs for the whole length of a shift.
+    // Not long-polling or SSE either, tempting as instant delivery is - both
+    // hold an Apache worker and a PHP process open per connected volunteer,
+    // and on the shared hosting these domains run on a single busy mission
+    // could exhaust the process pool and take the whole site down with it.
+    static final long POLL_INTERVAL_MS = 30000L;
+
+    private static final String PREFS_NAME = "VolunteerOpsAlertPoller";
+    private static final String KEY_CURSOR = "alert_cursor";
+
+    // Bumped from "volunteerops_alerts". A NotificationChannel's importance,
+    // sound and vibration are frozen the moment it is first created - not even
+    // the app that made it can change them afterwards, by design, so the user
+    // stays in control. The first version arrived silently on a real device
+    // (some OEM ROMs register channels from background-service apps as silent),
+    // and the only way to re-register with the settings below is a new id.
+    // If this ever needs correcting again, bump the suffix rather than editing
+    // the channel definition, which would silently do nothing.
+    //
+    // Since v3.332.0 this is the «Εντολές» channel only: alerts the web shows
+    // as a banner (`urgent`). Everything else goes to CHANNEL_UPDATES_ID.
+    // Before, every notification rang like an order — through Do Not Disturb
+    // and with the triple buzz — and a phone that buzzes the same for "your
+    // shift was approved" as for "go to point 3" teaches its owner to ignore
+    // both.
+    private static final String CHANNEL_ID = "volunteerops_alerts_v2";
+    private static final String CHANNEL_NAME = "Εντολές";
+    private static final String CHANNEL_UPDATES_ID = "volunteerops_updates";
+    // Distinct from the plugin's own silent foreground-service notification
+    // (NOTIFICATION_ID in BackgroundGeolocationService) so the two never
+    // overwrite each other.
+    private static final int NOTIFICATION_ID_BASE = 91000;
+
+    // Tapping a notification opens this URL in the app. MainActivity is the
+    // app's own class, outside this plugin, so both sides spell it out.
+    static final String EXTRA_OPEN_URL = "vopsOpenUrl";
+
+    // One alert as a Bundle: what the «Ελήφθη» button hands
+    // AlertActionReceiver, so the notification can be redrawn after the tap
+    // without asking the server what it said.
+    static final String A_ID = "vopsAlertId";
+    static final String A_WHEN = "vopsAlertWhen";
+    static final String A_TITLE = "vopsAlertTitle";
+    static final String A_MESSAGE = "vopsAlertMessage";
+    static final String A_URGENT = "vopsAlertUrgent";
+    static final String A_URL = "vopsAlertUrl";
+    static final String A_ACK_KIND = "vopsAlertAckKind";
+    static final String A_ACK_ID = "vopsAlertAckId";
+    static final String A_T_ACK = "vopsAlertTextAck";
+    static final String A_T_ACKED = "vopsAlertTextAcked";
+    static final String A_T_RETRY = "vopsAlertTextRetry";
+    static final String A_T_OPEN_APP = "vopsAlertTextOpenApp";
+
+    // What a notification is showing: as it arrived, «Ελήφθη» being sent, and
+    // the three outcomes. Only NEW makes a sound or lights the screen.
+    static final int STATE_NEW = 0;
+    static final int STATE_SENDING = 1;
+    static final int STATE_ACKED = 2;
+    // No connection — the button stays, to try again.
+    static final int STATE_RETRY = 3;
+    // The server said no, or tracking has stopped and there is no token to
+    // send it with — pressing again would not help; the app can.
+    static final int STATE_OPEN_APP = 4;
+
+    private static ExecutorService executor;
+
+    private AlertPoller() {}
+
+    static synchronized void poll(Context context) {
+        try {
+            String pingUrl = LocationStore.getUrl(context);
+            String authToken = LocationStore.getAuthToken(context);
+            if (pingUrl == null || pingUrl.isEmpty() || authToken == null || authToken.isEmpty()) {
+                return;
+            }
+            String base = LocationStore.siteBase(context);
+            if (executor == null) {
+                executor = Executors.newSingleThreadExecutor();
+            }
+            Context app = context.getApplicationContext();
+            int shiftId = LocationStore.getShiftId(context);
+            executor.execute(() -> fetchAndNotify(app, base, authToken, shiftId));
+        } catch (Exception ignore) {}
+    }
+
+    private static void fetchAndNotify(Context context, String baseUrl, String authToken, int shiftId) {
+        HttpURLConnection connection = null;
+        try {
+            long cursor = prefs(context).getLong(KEY_CURSOR, 0L);
+            // VolunteerOps (v3.330.0): the shift this service tracks, so the
+            // reply can also say whether to keep tracking it — see
+            // BackgroundGeolocationService.applyTrackingInstruction().
+            String url = baseUrl + "/mobile-alerts.php?since_id=" + cursor + (shiftId > 0 ? "&shift_id=" + shiftId : "");
+
+            connection = (HttpURLConnection) new URL(url).openConnection();
+            connection.setRequestMethod("GET");
+            connection.setConnectTimeout(10000);
+            connection.setReadTimeout(10000);
+            connection.setRequestProperty("Accept", "application/json");
+            connection.setRequestProperty("Authorization", "Bearer " + authToken);
+
+            if (connection.getResponseCode() != 200) {
+                return;
+            }
+
+            StringBuilder sb = new StringBuilder();
+            try (BufferedReader reader = new BufferedReader(
+                new InputStreamReader(connection.getInputStream(), StandardCharsets.UTF_8))) {
+                String line;
+                while ((line = reader.readLine()) != null) {
+                    sb.append(line);
+                }
+            }
+
+            JSONObject body = new JSONObject(sb.toString());
+            if (!body.optBoolean("ok", false)) {
+                return;
+            }
+
+            // Absent from an older server's reply, and from any reply to a
+            // request without a shift: then nothing changes.
+            String tracking = body.optString("tracking", "");
+            if (!tracking.isEmpty()) {
+                BackgroundGeolocationService.applyTrackingInstruction(tracking);
+            }
+
+            JSONArray alerts = body.optJSONArray("alerts");
+            JSONObject texts = body.optJSONObject("texts");
+            if (alerts != null) {
+                for (int i = 0; i < alerts.length(); i++) {
+                    JSONObject alert = alerts.optJSONObject(i);
+                    if (alert == null) continue;
+                    show(context, alertBundle(baseUrl, alert, texts, i), STATE_NEW);
+                }
+            }
+
+            // Advanced only after the notifications above have actually been
+            // raised, so a crash mid-loop re-delivers rather than silently
+            // swallowing an order.
+            long newCursor = body.optLong("cursor", cursor);
+            if (newCursor != cursor) {
+                prefs(context).edit().putLong(KEY_CURSOR, newCursor).apply();
+            }
+        } catch (Exception e) {
+            // Never surface: a failed alert check must not disturb the
+            // location tracking this service exists for.
+            Logger.debug("AlertPoller failed: " + e.getMessage());
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+    }
+
+    private static Bundle alertBundle(String baseUrl, JSONObject alert, JSONObject texts, int index) {
+        Bundle a = new Bundle();
+        a.putInt(A_ID, alert.optInt("id", index));
+        a.putLong(A_WHEN, System.currentTimeMillis());
+        a.putString(A_TITLE, alert.optString("title", ""));
+        a.putString(A_MESSAGE, alert.optString("message", ""));
+        a.putBoolean(A_URGENT, alert.optBoolean("urgent", false));
+        // Relative to the site by contract (mobile-alerts.php). Anything with a
+        // scheme or a host of its own is dropped rather than trusted, so a
+        // notification can only ever open this site.
+        String path = alert.optString("url", "");
+        if (!path.isEmpty() && !path.contains("://") && !path.startsWith("//")) {
+            a.putString(A_URL, baseUrl + "/" + (path.startsWith("/") ? path.substring(1) : path));
+        }
+        JSONObject ack = alert.optJSONObject("ack");
+        if (ack != null && texts != null && !texts.optString("ack", "").isEmpty()) {
+            a.putString(A_ACK_KIND, ack.optString("kind", ""));
+            a.putInt(A_ACK_ID, ack.optInt("id", 0));
+            a.putString(A_T_ACK, texts.optString("ack", ""));
+            a.putString(A_T_ACKED, texts.optString("acked", ""));
+            a.putString(A_T_RETRY, texts.optString("ack_retry", ""));
+            a.putString(A_T_OPEN_APP, texts.optString("ack_open_app", ""));
+        }
+        return a;
+    }
+
+    /**
+     * Draws one alert, or redraws it in a later state under the same id. The
+     * only place a notification's look is decided, so the one the «Ελήφθη»
+     * button leaves behind cannot drift from the one that arrived.
+     */
+    static void show(Context context, Bundle a, int state) {
+        NotificationManager manager = (NotificationManager) context.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (manager == null) return;
+
+        ensureChannels(manager);
+
+        boolean urgent = a.getBoolean(A_URGENT, false);
+        int notificationId = NOTIFICATION_ID_BASE + (a.getInt(A_ID, 0) % 1000);
+        String title = a.getString(A_TITLE, "");
+        String message = a.getString(A_MESSAGE, "");
+        String status = statusLine(a, state);
+
+        Notification.Builder builder = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
+            ? new Notification.Builder(context, urgent ? CHANNEL_ID : CHANNEL_UPDATES_ID)
+            : new Notification.Builder(context);
+
+        builder
+            .setContentTitle(title.isEmpty() ? context.getString(context.getApplicationInfo().labelRes) : title)
+            .setContentText(status == null ? message : status)
+            // Orders carry real text, and a collapsed line truncates it to
+            // uselessness on a lock screen.
+            .setStyle(new Notification.BigTextStyle().bigText(status == null ? message : status + "\n\n" + message))
+            .setAutoCancel(true)
+            // Redrawn after «Ελήφθη» is pressed: that must not ring again.
+            .setOnlyAlertOnce(state != STATE_NEW)
+            // A group of its own. Android bundles an app's ungrouped
+            // notifications once there are two, and this app always has one
+            // already — the GPS service's. Seen on Android 15: the order sat
+            // inside a collapsed «ΕΠΙΔΡΑΣΙΣ · 2» on the lock screen, its
+            // «Ελήφθη» button two taps deep.
+            .setGroup("vopsAlert" + notificationId)
+            .setWhen(a.getLong(A_WHEN, System.currentTimeMillis()))
+            .setShowWhen(true);
+
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) {
+            // Pre-O has no channels, so sound/vibration/priority live on the
+            // notification itself.
+            builder.setPriority(urgent ? Notification.PRIORITY_MAX : Notification.PRIORITY_DEFAULT);
+            builder.setDefaults(urgent ? Notification.DEFAULT_SOUND | Notification.DEFAULT_VIBRATE : Notification.DEFAULT_SOUND);
+        }
+
+        int iconRes = 0;
+        try {
+            String name = BackgroundGeolocationService.getAppString(
+                "capacitor_background_geolocation_notification_icon", "mipmap/ic_launcher", context);
+            String[] parts = name.split("/");
+            iconRes = BackgroundGeolocationService.getAppResourceIdentifier(parts[1], parts[0], context);
+            builder.setSmallIcon(iconRes);
+        } catch (Exception e) {
+            Logger.error("Could not set alert notification icon", e);
+        }
+
+        // Tapping opens the app rather than the OS app-settings screen, which
+        // is what happens if no content intent is set — and since v3.332.0 at
+        // the order itself, not wherever the app last was: after an hour in a
+        // pocket Android has often closed it, and it would start on the home
+        // page.
+        Intent launchIntent = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName());
+        if (launchIntent != null) {
+            launchIntent.addFlags(Intent.FLAG_ACTIVITY_REORDER_TO_FRONT);
+            String url = a.getString(A_URL);
+            if (url != null) {
+                launchIntent.putExtra(EXTRA_OPEN_URL, url);
+            }
+            builder.setContentIntent(
+                PendingIntent.getActivity(
+                    context, notificationId, launchIntent,
+                    PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE
+                )
+            );
+        }
+
+        // «Ελήφθη», until it has been sent. A broadcast, not an activity:
+        // Android asks for the phone to be unlocked before starting an
+        // activity from the lock screen, and answering without unlocking is
+        // the point of the button.
+        if (a.getString(A_ACK_KIND) != null && (state == STATE_NEW || state == STATE_RETRY)) {
+            Intent tap = new Intent(context, AlertActionReceiver.class)
+                .setAction(AlertActionReceiver.ACTION_ACK)
+                .putExtras(a);
+            PendingIntent pending = PendingIntent.getBroadcast(
+                context, notificationId, tap,
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE
+            );
+            builder.addAction(
+                new Notification.Action.Builder(
+                    Icon.createWithResource(context, iconRes != 0 ? iconRes : android.R.drawable.checkbox_on_background),
+                    a.getString(A_T_ACK, ""),
+                    pending
+                ).build()
+            );
+        }
+
+        // Unique id per alert so several orders stack instead of replacing
+        // one another.
+        manager.notify(notificationId, builder.build());
+
+        if (state == STATE_NEW && urgent) {
+            wakeScreen(context);
+        }
+    }
+
+    private static String statusLine(Bundle a, int state) {
+        switch (state) {
+            case STATE_SENDING: return a.getString(A_T_ACK, "") + "…";
+            case STATE_ACKED: return a.getString(A_T_ACKED, "");
+            case STATE_RETRY: return a.getString(A_T_RETRY, "");
+            case STATE_OPEN_APP: return a.getString(A_T_OPEN_APP, "");
+            default: return null;
+        }
+    }
+
+    /**
+     * Sends «Ελήφθη» for the alert's order (mobile-order-ack.php) and returns
+     * the state to redraw the notification in. Blocking — AlertActionReceiver
+     * runs it off the main thread. Short timeouts: someone is looking at the
+     * notification, and "no connection, try again" is a better answer than a
+     * long wait.
+     */
+    static int acknowledge(Context context, Bundle a) {
+        String base = LocationStore.siteBase(context);
+        String token = LocationStore.getAuthToken(context);
+        // Tracking has stopped since the notification came, and stopping
+        // clears the token with everything else (LocationStore.clear()).
+        if (base == null || token == null || token.isEmpty()) {
+            return STATE_OPEN_APP;
+        }
+        String ref = a.getString(A_ACK_KIND, "") + ":" + a.getInt(A_ACK_ID, 0);
+        HttpURLConnection connection = null;
+        int state;
+        try {
+            byte[] body = ("kind=" + URLEncoder.encode(a.getString(A_ACK_KIND, ""), "UTF-8")
+                + "&id=" + a.getInt(A_ACK_ID, 0)).getBytes(StandardCharsets.UTF_8);
+            connection = (HttpURLConnection) new URL(base + "/mobile-order-ack.php").openConnection();
+            connection.setRequestMethod("POST");
+            connection.setConnectTimeout(5000);
+            connection.setReadTimeout(5000);
+            connection.setDoOutput(true);
+            connection.setRequestProperty("Accept", "application/json");
+            connection.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
+            connection.setRequestProperty("Authorization", "Bearer " + token);
+            try (OutputStream out = connection.getOutputStream()) {
+                out.write(body);
+            }
+            int code = connection.getResponseCode();
+            if (code == 401) {
+                state = STATE_OPEN_APP;
+            } else if (code != 200) {
+                state = STATE_RETRY;
+            } else {
+                StringBuilder sb = new StringBuilder();
+                try (BufferedReader reader = new BufferedReader(
+                    new InputStreamReader(connection.getInputStream(), StandardCharsets.UTF_8))) {
+                    String line;
+                    while ((line = reader.readLine()) != null) {
+                        sb.append(line);
+                    }
+                }
+                state = new JSONObject(sb.toString()).optBoolean("ok", false) ? STATE_ACKED : STATE_OPEN_APP;
+            }
+        } catch (Exception e) {
+            state = STATE_RETRY;
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+        DebugLog.log(context, "alert_ack", ref + " -> " + (state == STATE_ACKED ? "acked" : state == STATE_RETRY ? "retry" : "open_app"));
+        return state;
+    }
+
+    /**
+     * Lights the screen for an operational order so the notification is seen
+     * rather than merely delivered. Urgent alerts only - the ones that already
+     * trigger the red banner on the web - so routine account notices never
+     * light up a phone in someone's pocket.
+     *
+     * Deliberately NOT a full-screen intent: that takes the phone over like an
+     * incoming call, and on Android 14+ it needs a permission only granted to
+     * calling and alarm apps, so it would cost an extra setup prompt for every
+     * volunteer. This is the proportionate version - the device still stays
+     * locked, because nothing an app does can or should unlock it.
+     *
+     * The 10s timeout is load-bearing: a wake lock leaked by an exception on a
+     * phone already running a location service all shift would be a real
+     * battery problem, so the OS is told up front to release it regardless.
+     */
+    private static void wakeScreen(Context context) {
+        PowerManager.WakeLock lock = null;
+        try {
+            PowerManager pm = (PowerManager) context.getSystemService(Context.POWER_SERVICE);
+            if (pm == null || pm.isInteractive()) return; // already awake, nothing to do
+            lock = pm.newWakeLock(
+                PowerManager.SCREEN_BRIGHT_WAKE_LOCK | PowerManager.ACQUIRE_CAUSES_WAKEUP | PowerManager.ON_AFTER_RELEASE,
+                "VolunteerOps:alert"
+            );
+            lock.acquire(10000);
+        } catch (Exception e) {
+            Logger.debug("wakeScreen failed: " + e.getMessage());
+        }
+    }
+
+    private static void ensureChannels(NotificationManager manager) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return;
+
+        NotificationChannel existing = manager.getNotificationChannel(CHANNEL_ID);
+        if (existing != null) {
+            // Created as «Εντολές & Ειδοποιήσεις» before v3.332.0, when it
+            // carried everything. A channel's name and description are the
+            // two things an app may still change; its importance, sound and
+            // vibration stay exactly as they were.
+            if (!CHANNEL_NAME.equals(String.valueOf(existing.getName()))) {
+                existing.setName(CHANNEL_NAME);
+                existing.setDescription("Εντολές από το κέντρο επιχειρήσεων");
+                manager.createNotificationChannel(existing);
+            }
+        } else {
+            NotificationChannel channel = new NotificationChannel(
+                CHANNEL_ID,
+                CHANNEL_NAME,
+                // IMPORTANCE_HIGH is what makes it a heads-up notification with
+                // sound - the plugin's own tracking channel is deliberately
+                // silent, and reusing it would make every order silent too.
