+package com.capgo.capacitor_background_geolocation;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+
+/**
+ * VolunteerOps addition (v3.332.0, not upstream).
+ *
+ * The «Ελήφθη» button on an order notification (AlertPoller.show()). A
+ * volunteer can confirm an order from the lock screen, and the command post's
+ * acknowledgement panel ticks them off within seconds, without the phone
+ * being unlocked or the Action Room opened.
+ *
+ * Redraws the notification at once («Ελήφθη…», no button), so a second tap is
+ * not tempting while the request is out, then with the outcome.
+ */
+public class AlertActionReceiver extends BroadcastReceiver {
+
+    static final String ACTION_ACK = AlertActionReceiver.class.getPackage().getName() + ".vopsAlertAck";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (intent == null || !ACTION_ACK.equals(intent.getAction())) return;
+        final Bundle alert = intent.getExtras();
+        if (alert == null) return;
+        final Context app = context.getApplicationContext();
+
+        AlertPoller.show(app, alert, AlertPoller.STATE_SENDING);
+
+        // The request outlives onReceive(). goAsync() keeps the broadcast open
+        // until it is done; the connection's own 5 s timeouts keep that well
+        // inside the time Android allows a receiver.
+        final PendingResult pending = goAsync();
+        new Thread(() -> {
+            try {
+                AlertPoller.show(app, alert, AlertPoller.acknowledge(app, alert));
+            } finally {
+                pending.finish();
+            }
+        }, "VolunteerOpsAlertAck").start();
+    }
+}
