@@ -0,0 +1,74 @@
+package com.capgo.capacitor_background_geolocation;
+
+import android.content.Context;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import org.json.JSONObject;
+
+// VolunteerOps patch — TEMPORARY diagnostic aid, not part of the plugin
+// upstream. Exists for one reason: a recurring "native background tracking
+// shows the notification active but no pings arrive" bug kept resisting
+// fixes because this dev environment has no adb/USB access to the real
+// device and no SSH access to the live production domains the app talks
+// to — so instead of guessing again, key lifecycle events get POSTed to
+// mobile-debug-log.php (same server the real GPS pings already go to,
+// same bearer token), where they can be read back from an admin-only page
+// on the live domain. Deliberately on its own executor, never the real
+// postExecutor — a diagnostic call must never be able to displace or delay
+// a real location POST, and every failure here is swallowed. Remove this
+// file and its call sites once the underlying bug is actually closed.
+final class DebugLog {
+
+    private static ExecutorService executor;
+
+    private DebugLog() {}
+
+    static synchronized void log(Context context, String event, String detail) {
+        try {
+            String pingUrl = LocationStore.getUrl(context);
+            String authToken = LocationStore.getAuthToken(context);
+            if (pingUrl == null || pingUrl.isEmpty() || authToken == null || authToken.isEmpty()) {
+                return;
+            }
+            URL parsed = new URL(pingUrl);
+            String debugUrl = parsed.getProtocol() + "://" + parsed.getAuthority() + "/mobile-debug-log.php";
+            if (executor == null) {
+                executor = Executors.newSingleThreadExecutor();
+            }
+            executor.execute(() -> post(debugUrl, authToken, event, detail));
+        } catch (Exception ignore) {}
+    }
+
+    private static void post(String url, String authToken, String event, String detail) {
+        HttpURLConnection connection = null;
+        try {
+            JSONObject body = new JSONObject();
+            body.put("source", "native");
+            body.put("event", event);
+            body.put("detail", detail == null ? "" : detail);
+            byte[] bytes = body.toString().getBytes(StandardCharsets.UTF_8);
+
+            connection = (HttpURLConnection) new URL(url).openConnection();
+            connection.setRequestMethod("POST");
+            connection.setConnectTimeout(5000);
+            connection.setReadTimeout(5000);
+            connection.setDoOutput(true);
+            connection.setRequestProperty("Content-Type", "application/json");
+            connection.setRequestProperty("Authorization", "Bearer " + authToken);
+            try (OutputStream os = connection.getOutputStream()) {
+                os.write(bytes);
+            }
+            connection.getResponseCode();
+        } catch (Exception ignore) {
+            // A diagnostic call must never surface its own error.
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+}
