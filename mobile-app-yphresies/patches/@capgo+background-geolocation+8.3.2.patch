+package com.capgo.capacitor_background_geolocation;
+
+import android.Manifest;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.location.LocationManager;
+import android.os.Build;
+import android.os.PowerManager;
+import android.provider.Settings;
+import androidx.core.content.ContextCompat;
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Logger;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import org.json.JSONObject;
+
+/**
+ * VolunteerOps addition (not upstream).
+ *
+ * Why a phone is not producing good positions, from the one place that can
+ * see it. A web page can only learn that a fix failed; it cannot see the
+ * phone's location switch, whether the user granted only "approximate"
+ * location, or that battery saver is cutting GPS the moment the screen goes
+ * dark - and the last of those is exactly the case where the page is frozen
+ * and cannot report anything at all.
+ *
+ * Two uses:
+ *  - diagnostics(): read by the Action Room page when tracking starts, so the
+ *    volunteer is told what to fix while they are still looking at the screen;
+ *  - report(): called by the background service when its watchdog finds no
+ *    fix has arrived, so the command post's roster says WHY this volunteer
+ *    went quiet instead of reading like somebody resting.
+ *
+ * Reason names are the server's (VOLUNTEER_GPS_CLIENT_REASONS in
+ * includes/functions-warroom.php); anything else is refused there.
+ */
+final class VopsGpsHealth {
+
+    // PowerManager.LOCATION_MODE_* values that stop or throttle location for
+    // a screen-off phone. FOREGROUND_ONLY (3) is not among them: a foreground
+    // service counts as foreground for that mode, which is what this is.
+    private static final int LOCATION_MODE_GPS_DISABLED_WHEN_SCREEN_OFF = 1;
+    private static final int LOCATION_MODE_ALL_DISABLED_WHEN_SCREEN_OFF = 2;
+    private static final int LOCATION_MODE_THROTTLE_REQUESTS_WHEN_SCREEN_OFF = 4;
+
+    private static ExecutorService executor;
+    private static String lastReportedReason;
+    private static long lastReportedAt;
+    // The same reason is not re-sent more often than this. The server keeps
+    // it until a fix arrives anyway, and protects it from the page's own less
+    // specific reports for 5 minutes (recordVolunteerGpsErrorReason()) - so
+    // this must stay UNDER 5 minutes, or a cause that still holds could lapse
+    // and be replaced by a symptom between two repeats.
+    private static final long REPORT_REPEAT_MS = 4 * 60 * 1000L;
+
+    private VopsGpsHealth() {}
+
+    static String deviceLabel() {
+        String maker = Build.MANUFACTURER == null ? "" : Build.MANUFACTURER.trim();
+        String model = Build.MODEL == null ? "" : Build.MODEL.trim();
+        // Most models already start with the maker's name ("Pixel" does not,
+        // "SM-A525F" does not, "Redmi Note 12" does not; some do). Avoid
+        // "samsung samsung SM-...".
+        String name = model.toLowerCase().startsWith(maker.toLowerCase()) ? model : (maker + " " + model).trim();
+        return name + " · Android " + Build.VERSION.RELEASE;
+    }
+
+    static boolean hasFine(Context context) {
+        return ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    static boolean hasCoarse(Context context) {
+        return ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    static boolean locationEnabled(Context context) {
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                LocationManager lm = (LocationManager) context.getSystemService(Context.LOCATION_SERVICE);
+                return lm != null && lm.isLocationEnabled();
+            }
+            return Settings.Secure.getInt(context.getContentResolver(), Settings.Secure.LOCATION_MODE, Settings.Secure.LOCATION_MODE_OFF)
+                != Settings.Secure.LOCATION_MODE_OFF;
+        } catch (Exception e) {
+            return true; // unknown: do not claim it is off
+        }
+    }
+
+    /** Battery saver is on AND set to cut or throttle location with the screen off. */
+    static boolean powerSaveCutsGps(Context context) {
+        try {
+            PowerManager pm = (PowerManager) context.getSystemService(Context.POWER_SERVICE);
+            if (pm == null || !pm.isPowerSaveMode() || Build.VERSION.SDK_INT < Build.VERSION_CODES.P) {
+                return false;
+            }
+            int mode = pm.getLocationPowerSaveMode();
+            return mode == LOCATION_MODE_GPS_DISABLED_WHEN_SCREEN_OFF
+                || mode == LOCATION_MODE_ALL_DISABLED_WHEN_SCREEN_OFF
+                || mode == LOCATION_MODE_THROTTLE_REQUESTS_WHEN_SCREEN_OFF;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    static boolean screenOn(Context context) {
+        try {
+            PowerManager pm = (PowerManager) context.getSystemService(Context.POWER_SERVICE);
+            return pm == null || pm.isInteractive();
+        } catch (Exception e) {
+            return true;
+        }
+    }
+
+    static boolean ignoringBatteryOptimizations(Context context) {
+        try {
+            PowerManager pm = (PowerManager) context.getSystemService(Context.POWER_SERVICE);
+            return pm != null && pm.isIgnoringBatteryOptimizations(context.getPackageName());
+        } catch (Exception e) {
+            return true; // unknown: do not nag
+        }
+    }
+
+    static JSObject diagnostics(Context context) {
+        JSObject o = new JSObject();
+        o.put("fine", hasFine(context));
+        o.put("coarse", hasCoarse(context));
+        o.put("locationEnabled", locationEnabled(context));
+        o.put("powerSaveCutsGps", powerSaveCutsGps(context));
+        o.put("ignoringBatteryOptimizations", ignoringBatteryOptimizations(context));
+        o.put("device", deviceLabel());
+        return o;
+    }
+
+    /**
+     * The most specific explanation for "no fix is arriving", or null when
+     * nothing on the phone explains it (then it is the sky: indoors, a gorge,
+     * a pocket - and 'unavailable' is the honest answer).
+     */
+    static String problemReason(Context context) {
+        if (!hasFine(context) && !hasCoarse(context)) return "denied";
+        if (!locationEnabled(context)) return "location_off";
+        if (!hasFine(context)) return "imprecise";
+        if (!screenOn(context) && powerSaveCutsGps(context)) return "power_save";
+        return null;
+    }
+
+    /** A fix arrived: whatever was reported is over, so the next problem is news again. */
+    static synchronized void clear() {
+        lastReportedReason = null;
+        lastReportedAt = 0L;
+    }
+
+    /**
+     * POSTs {reason} to mobile-gps-error.php, derived from the configured ping
+     * URL so a subfolder install and the shift_id query string both carry
+     * over. Fire-and-forget on its own thread; a failure is only logged.
+     */
+    static synchronized void report(Context context, String reason) {
+        long now = System.currentTimeMillis();
+        if (reason.equals(lastReportedReason) && now - lastReportedAt < REPORT_REPEAT_MS) {
+            return;
+        }
+        String pingUrl = LocationStore.getUrl(context);
+        String token = LocationStore.getAuthToken(context);
+        if (pingUrl == null || !pingUrl.contains("mobile-ping-location.php") || token == null || token.isEmpty()) {
+            return;
+        }
+        lastReportedReason = reason;
+        lastReportedAt = now;
+        final String url = pingUrl.replace("mobile-ping-location.php", "mobile-gps-error.php");
+        final Context app = context.getApplicationContext();
+        if (executor == null) {
+            executor = Executors.newSingleThreadExecutor();
+        }
+        executor.execute(() -> {
+            HttpURLConnection connection = null;
+            try {
+                byte[] body = new JSONObject().put("reason", reason).toString().getBytes(StandardCharsets.UTF_8);
+                connection = (HttpURLConnection) new URL(url).openConnection();
+                connection.setRequestMethod("POST");
+                connection.setConnectTimeout(8000);
+                connection.setReadTimeout(8000);
+                connection.setDoOutput(true);
+                connection.setRequestProperty("Accept", "application/json");
+                connection.setRequestProperty("Content-Type", "application/json");
+                connection.setRequestProperty("Authorization", "Bearer " + token);
+                try (OutputStream out = connection.getOutputStream()) {
+                    out.write(body);
+                }
+                int code = connection.getResponseCode();
+                DebugLog.log(app, "gps_error_reported", reason + " http=" + code);
+            } catch (Exception e) {
+                Logger.error("GPS error report failed", e);
+                DebugLog.log(app, "gps_error_report_failed", reason + " " + e.getMessage());
+            } finally {
+                if (connection != null) connection.disconnect();
+            }
+        });
+    }
+}
