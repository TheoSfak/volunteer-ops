+            if (age >= 0 && age <= MAX_AGE_MS) kept.put(e);
+        }
+        if (kept.length() <= MAX_ENTRIES) return kept;
+        JSONArray capped = new JSONArray();
+        for (int i = kept.length() - MAX_ENTRIES; i < kept.length(); i++) capped.put(kept.opt(i));
+        return capped;
+    }
