+    static synchronized void add(Context context, JSONObject payload, long fixElapsedMs) {
+        try {
+            SharedPreferences p = prefs(context);
+            long seq = p.getLong(KEY_SEQ, 0L) + 1;
+            p.edit().putLong(KEY_SEQ, seq).apply();
+            JSONObject entry = new JSONObject();
+            entry.put("i", seq);
+            entry.put("e", fixElapsedMs);
+            entry.put("p", payload);
+            JSONArray entries = load(context);
+            entries.put(entry);
+            save(context, prune(entries));
+        } catch (Exception e) {
+            Logger.error("Could not keep a fix", e);
+        }
+    }
+
+    static synchronized int size(Context context) {
+        return prune(load(context)).length();
+    }
+
+    /** Removes every kept fix with a sequence number up to and including $lastSeq. */
+    private static synchronized void removeThrough(Context context, long lastSeq) {
+        JSONArray entries = load(context);
+        JSONArray kept = new JSONArray();
+        for (int i = 0; i < entries.length(); i++) {
+            JSONObject e = entries.optJSONObject(i);
+            if (e != null && e.optLong("i") > lastSeq) kept.put(e);
+        }
+        save(context, prune(kept));
+    }
+
+    /** The oldest $max fixes, each stamped with its age as of now. */
+    private static synchronized JSONObject[] oldest(Context context, int max) {
+        JSONArray entries = prune(load(context));
+        save(context, entries);
+        int n = Math.min(max, entries.length());
+        JSONObject[] out = new JSONObject[n];
+        long now = SystemClock.elapsedRealtime();
+        for (int i = 0; i < n; i++) {
+            JSONObject e = entries.optJSONObject(i);
+            try {
+                // A copy: the kept entry must stay exactly as it was if this
+                // send fails, and its age is only true at this moment.
+                JSONObject payload = new JSONObject(e.getJSONObject("p").toString());
+                payload.put("fix_age_ms", Math.max(0L, now - e.getLong("e")));
+                JSONObject wrapped = new JSONObject();
+                wrapped.put("i", e.getLong("i"));
+                wrapped.put("p", payload);
+                out[i] = wrapped;
+            } catch (Exception ex) {
+                out[i] = null;
+            }
+        }
+        return out;
+    }
+
+    /**
+     * Empties the buffer in the background, oldest first. Coalesced: calls
+     * made while a drain is already waiting to run add nothing, so an outage
+     * does not pile up attempts behind each other — the failure the old
+     * unbounded post queue had.
+     */
+    static void drainAsync(Context context) {
+        if (!drainQueued.compareAndSet(false, true)) return;
+        final Context app = context.getApplicationContext();
+        executor.execute(() -> {
+            drainQueued.set(false);
+            drain(app);
+        });
+    }
+
+    private static void drain(Context context) {
+        while (true) {
+            JSONObject[] batch = oldest(context, BATCH);
+            if (batch.length == 0) return;
+            long lastSeq = -1;
+            try {
+                if (batch.length == 1) {
+                    // The everyday case, online: the same single-object body
+                    // every server version has always understood.
+                    if (batch[0] == null || LocationStore.postJson(context, batch[0].getJSONObject("p").toString()) == null) return;
+                    lastSeq = batch[0].getLong("i");
+                } else {
+                    JSONArray body = new JSONArray();
+                    for (JSONObject w : batch) {
+                        if (w != null) body.put(w.getJSONObject("p"));
+                    }
+                    String reply = LocationStore.postJson(context, body.toString());
+                    if (reply == null) return;
+                    if (reply.contains("\"batch\"")) {
+                        lastSeq = batch[batch.length - 1].getLong("i");
+                        DebugLog.log(context, "backlog_sent", body.length() + " fixes in one request");
+                    } else {
+                        // A server from before v3.322.0 does not know the list
+                        // form. One at a time, stopping at the first failure.
+                        for (JSONObject w : batch) {
+                            if (w == null) continue;
+                            if (LocationStore.postJson(context, w.getJSONObject("p").toString()) == null) break;
+                            lastSeq = w.getLong("i");
+                        }
+                    }
+                }
+            } catch (Exception e) {
+                // No signal, or the server refused the request itself: keep
+                // everything for the next attempt.
+                if (lastSeq >= 0) removeThrough(context, lastSeq);
+                DebugLog.log(context, "post_failed_kept", size(context) + " fixes kept: " + e.getMessage());
+                return;
+            }
+            if (lastSeq < 0) return;
+            removeThrough(context, lastSeq);
+        }
+    }
+}
