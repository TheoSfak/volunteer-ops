+package com.capgo.capacitor_background_geolocation;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.SystemClock;
+import com.getcapacitor.Logger;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * VolunteerOps addition (not upstream, v3.322.0).
+ *
+ * Keeps every fix until the server has it. Before this, a fix whose POST
+ * failed was simply lost, so a volunteer walking through a gorge with no
+ * signal left no trace of the route they took through it — exactly the part
+ * of a search a coordinator most needs to see afterwards.
+ *
+ * Every fix is appended here and the buffer is emptied oldest first. A failed
+ * send keeps everything and stops; the next fix, or the 30-second alert poll,
+ * tries again. That order matters: the server skips any fix older than the
+ * newest one it already has, so sending a new fix ahead of a backlog would
+ * throw the backlog away.
+ *
+ * The reason v3.158.2 chose to DROP fixes instead no longer applies. Then, a
+ * backlog was replayed one POST per fix, holding the volunteer's current
+ * position back behind minutes of old ones, and every replayed fix was stamped
+ * with its arrival time. Now the backlog goes up in batches of 50 per request,
+ * so catching up takes seconds, and each fix carries its own age.
+ *
+ * Bounded twice: nothing older than 30 minutes (the server refuses those
+ * anyway, WAR_ROOM_MAX_FIX_AGE_SECONDS) and never more than 400 fixes (30
+ * minutes at the fastest cadence the settings allow). Persisted, so a service
+ * the system kills and restarts mid-outage does not lose it. Ages are measured
+ * on the monotonic clock; after a reboot that clock restarts and a kept fix's
+ * age can no longer be known, so it is dropped rather than guessed.
+ */
+final class VopsFixBuffer {
+
+    static final long MAX_AGE_MS = 30 * 60 * 1000L;
+    static final int MAX_ENTRIES = 400;
+    static final int BATCH = 50;
+
+    private static final String PREFS = "VopsFixBuffer";
+    private static final String KEY_ENTRIES = "entries";
+    private static final String KEY_SEQ = "seq";
+
+    private static final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private static final AtomicBoolean drainQueued = new AtomicBoolean(false);
+
+    private VopsFixBuffer() {}
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static JSONArray load(Context context) {
+        try {
+            return new JSONArray(prefs(context).getString(KEY_ENTRIES, "[]"));
+        } catch (Exception e) {
+            return new JSONArray();
+        }
+    }
+
+    private static void save(Context context, JSONArray entries) {
+        prefs(context).edit().putString(KEY_ENTRIES, entries.toString()).apply();
+    }
+
+    /** Drops what can no longer be delivered: too old, from before a reboot, or over the cap. */
+    private static JSONArray prune(JSONArray entries) {
+        long now = SystemClock.elapsedRealtime();
+        JSONArray kept = new JSONArray();
+        for (int i = 0; i < entries.length(); i++) {
+            JSONObject e = entries.optJSONObject(i);
+            // A damaged entry would sit at the head forever and block every
+            // fix behind it, so it goes here rather than at send time.
+            if (e == null || !e.has("i") || !e.has("e") || e.optJSONObject("p") == null) continue;
